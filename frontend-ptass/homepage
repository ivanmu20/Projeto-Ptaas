import React, { useState } from 'react';
import { Shield, Lock, FileText, Settings, ChevronRight, CheckCircle, XCircle, Loader } from 'lucide-react';

const App = () => {
  const [currentPage, setCurrentPage] = useState('main');

  const goToRGPDScanner = () => {
    setCurrentPage('rgpd-scanner');
  };

  const goToMain = () => {
    setCurrentPage('main');
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
      {currentPage === 'main' && <MainHomePage goToRGPDScanner={goToRGPDScanner} />}
      {currentPage === 'rgpd-scanner' && <RGPDScanner goBack={goToMain} />}
    </div>
  );
};

// ============================================
// MAIN HOMEPAGE COMPONENT
// ============================================
const MainHomePage = ({ goToRGPDScanner }) => {
  const scanners = [
    {
      id: 'rgpd',
      title: 'RGPD Scanner',
      description: 'Verify your GDPR/RGPD compliance with automated testing',
      icon: Shield,
      color: 'green',
      available: true,
      action: goToRGPDScanner
    },
    {
      id: 'security',
      title: 'Security Scanner',
      description: 'Comprehensive security vulnerability assessment',
      icon: Lock,
      color: 'blue',
      available: false
    },
    {
      id: 'compliance',
      title: 'Compliance Audit',
      description: 'Full compliance report for multiple regulations',
      icon: FileText,
      color: 'purple',
      available: false
    },
    {
      id: 'custom',
      title: 'Custom Scanner',
      description: 'Configure your own scanning parameters',
      icon: Settings,
      color: 'orange',
      available: false
    }
  ];

  const colorClasses = {
    green: {
      bg: 'from-green-500 to-green-600',
      icon: 'bg-green-100 text-green-600'
    },
    blue: {
      bg: 'from-blue-500 to-blue-600',
      icon: 'bg-blue-100 text-blue-600'
    },
    purple: {
      bg: 'from-purple-500 to-purple-600',
      icon: 'bg-purple-100 text-purple-600'
    },
    orange: {
      bg: 'from-orange-500 to-orange-600',
      icon: 'bg-orange-100 text-orange-600'
    }
  };

  return (
    <div className="min-h-screen flex items-center justify-center p-8">
      <div className="max-w-6xl w-full">
        <div className="text-center mb-12">
          <div className="flex items-center justify-center gap-3 mb-6">
            <div className="w-16 h-16 bg-gradient-to-br from-green-500 to-blue-600 rounded-2xl flex items-center justify-center shadow-xl">
              <Shield className="w-8 h-8 text-white" />
            </div>
          </div>
          <h1 className="text-5xl font-bold text-white mb-4">
            Security & Compliance Platform
          </h1>
          <p className="text-gray-400 text-xl">
            Choose your scanning tool to get started
          </p>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {scanners.map((scanner) => {
            const Icon = scanner.icon;
            const colors = colorClasses[scanner.color];
            
            return (
              <div
                key={scanner.id}
                onClick={scanner.available ? scanner.action : null}
                className={`bg-white rounded-2xl shadow-xl overflow-hidden transition-all duration-300 ${
                  scanner.available 
                    ? 'cursor-pointer transform hover:scale-105 hover:shadow-2xl' 
                    : 'opacity-60 cursor-not-allowed'
                }`}
              >
                <div className={`bg-gradient-to-r ${colors.bg} p-6`}>
                  <div className="flex items-center justify-between">
                    <div className={`w-14 h-14 rounded-xl ${colors.icon} flex items-center justify-center`}>
                      <Icon className="w-7 h-7" />
                    </div>
                    {scanner.available ? (
                      <ChevronRight className="w-6 h-6 text-white" />
                    ) : (
                      <span className="bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full">
                        Coming Soon
                      </span>
                    )}
                  </div>
                </div>
                <div className="p-6">
                  <h3 className="text-2xl font-bold text-gray-800 mb-2">
                    {scanner.title}
                  </h3>
                  <p className="text-gray-600">
                    {scanner.description}
                  </p>
                </div>
              </div>
            );
          })}
        </div>

        <div className="text-center mt-12">
          <p className="text-gray-500 text-sm">
            Automated security testing and compliance verification platform
          </p>
        </div>
      </div>
    </div>
  );
};